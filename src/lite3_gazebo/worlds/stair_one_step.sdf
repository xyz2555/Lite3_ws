<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="lite3_single_step">

    <!-- ====================================================== -->
    <!-- Physics                                                -->
    <!-- ====================================================== -->

    <physics name="1ms"
             type="ode">

      <max_step_size>0.001</max_step_size>

      <real_time_update_rate>
        1000
      </real_time_update_rate>

    </physics>

    <gravity>
      0 0 -9.81
    </gravity>


    <!-- ====================================================== -->
    <!-- Scene                                                  -->
    <!-- ====================================================== -->

    <scene>

      <ambient>
        0.4 0.4 0.4 1
      </ambient>

      <background>
        0.7 0.7 0.7 1
      </background>

    </scene>


    <!-- ====================================================== -->
    <!-- Light                                                   -->
    <!-- ====================================================== -->

    <light
      name="sun"
      type="directional">

      <cast_shadows>true</cast_shadows>

      <pose>
        0 0 5 0 0 0
      </pose>

      <diffuse>
        1 1 1 1
      </diffuse>

      <specular>
        0.2 0.2 0.2 1
      </specular>

      <direction>
        -0.3 -0.2 -1
      </direction>

    </light>


    <!-- ====================================================== -->
    <!-- Lower ground                                            -->
    <!-- ====================================================== -->

    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">

          <geometry>

            <plane>

              <normal>
                0 0 1
              </normal>

              <size>
                20 10
              </size>

            </plane>

          </geometry>

          <surface>

            <friction>

              <ode>

                <mu>1.0</mu>
                <mu2>1.0</mu2>

              </ode>

            </friction>

          </surface>

        </collision>


        <visual name="ground_visual">

          <geometry>

            <plane>

              <normal>
                0 0 1
              </normal>

              <size>
                20 10
              </size>

            </plane>

          </geometry>

        </visual>

      </link>

    </model>


    <!-- ====================================================== -->
    <!-- One step                                                -->
    <!-- Height = 0.185 m                                       -->
    <!-- Tread  = 0.315 m                                       -->
    <!-- ====================================================== -->

    <model name="step_01">

      <static>true</static>

      <pose>
        0.1575 0 0.0925 0 0 0
      </pose>

      <link name="step_link">

        <collision name="step_collision">

          <geometry>

            <box>

              <size>
                0.315 2.00 0.185
              </size>

            </box>

          </geometry>


          <surface>

            <friction>

              <ode>

                <mu>1.0</mu>
                <mu2>1.0</mu2>

              </ode>

            </friction>

          </surface>

        </collision>


        <visual name="step_visual">

          <geometry>

            <box>

              <size>
                0.315 2.00 0.185
              </size>

            </box>

          </geometry>

          <material>

    <ambient>0.1 0.3 0.8 1</ambient>
    <diffuse>0.1 0.3 0.8 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>

  </material>

        </visual>

      </link>

    </model>


    <!-- ====================================================== -->
    <!-- Upper landing                                           -->
    <!-- ====================================================== -->

    <model name="top_landing">

      <static>true</static>

      <pose>
        0.7575 0 0.0925 0 0 0
      </pose>

      <link name="landing_link">

        <collision name="landing_collision">

          <geometry>

            <box>

              <size>
                0.885 2.00 0.185
              </size>

            </box>

          </geometry>


          <surface>

            <friction>

              <ode>

                <mu>1.0</mu>
                <mu2>1.0</mu2>

              </ode>

            </friction>

          </surface>

        </collision>


        <visual name="landing_visual">

          <geometry>

            <box>

              <size>
                0.885 2.00 0.185
              </size>

            </box>

          </geometry>

           <material>

    <ambient>0.45 0.45 0.45 1</ambient>
    <diffuse>0.55 0.55 0.55 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>

  </material>

        </visual>

      </link>

    </model>

  </world>

</sdf>